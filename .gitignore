# ── Secrets ──────────────────────────────────────────────────────────────
# NOTE: google-services.json is DELIBERATELY NOT ignored — EAS cloud builds
# only upload git-TRACKED files, and the build fails without it. It is a
# client config (ships inside every APK anyway), so committing it is safe.
# NEVER put the firebase-adminsdk (service account) key in the frontend.
google-services.json

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/

# ── Expo / Metro ─────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
*.orig.*

# ── Native builds (npx expo run:android / ios) ──────────────────────────
android/
ios/
*.apk
*.aab
*.jks
*.keystore

# ── Logs / OS ───────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.DS_Store
Thumbs.db

# ── Env ─────────────────────────────────────────────────────────────────
# .env is DELIBERATELY tracked: it only holds the LAN backend URL, and EAS
# Build only uploads git-tracked files. If it were ignored, the release APK
# would get an undefined API base URL and every request would fail with
# "Network error". Add real secrets to .env.local instead (still ignored).
.env.*
!.env.example
